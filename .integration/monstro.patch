+        addClipToTrack(Uri.fromFile(narration.file),TrackType.AUDIO)
+    }
+    fun applyMonstroPreset(p:com.monstro.v18.monstro.FxPreset) {
+        val clip=getSelectedClip() ?: return
+        val e=com.monstro.v18.monstro.MonstroEffectBridge.preset(p)
